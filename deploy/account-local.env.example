# Optional local-only customer portal. Production stays disabled until hosted.
#
# Secure verification: set SMTP_HOST / SMTP_FROM and CUSTOMER_FRONTEND_URL.
# In development, Mailpit catches messages without delivering externally.
CUSTOMER_ACCOUNTS_ENABLED=true
CUSTOMER_FRONTEND_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Lending Ezy Dev <no-reply@localhost.test>
SMTP_STARTTLS=false
